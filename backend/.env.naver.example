# Add these lines to backend/.env. Keep all existing settings.
# NAVER Cloud > VPC > Application Services > Maps > Application > Credentials
# Client ID (public web SDK identifier)
NAVER_MAP_CLIENT_ID=
# Client Secret (server only; never paste into HTML or JavaScript)
NAVER_MAP_CLIENT_SECRET=

# Business/place-name search: NAVER API HUB > Application > NAVER Search > Local.
# These differ from the NAVER Cloud Maps credentials above.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=
