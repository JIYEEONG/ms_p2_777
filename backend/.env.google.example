# Google Cloud > Google Auth Platform > Clients > Web application
# These are application credentials, NOT your Google email/password.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Register this exact URI under Authorized redirect URIs in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback
APP_BASE_URL=http://localhost:3000

# Generated automatically by tools/setup_google_env.py. Keep it server-side.
AUTH_SESSION_SECRET=
